<?php
$this->headLink()->appendStylesheet($this->assetUrl('css/page-blocks.css', 'Omeka'));
$this->htmlElement('body')->appendAttribute('class', $pageBodyClass);
$this->htmlElement('body')->appendAttribute('class', 'page-template-full-width');
$this->pageTitle($page->title(), 1);
//workaround to manually set active page because Laminas 'active' support doesn't work with CleanURL module
$nav = $site->publicNav();
$container = $nav->getContainer();
$thisPage = $container->findOneBy('label', $page->title());
if($thisPage !== null):
    $thisPage->setActive(true);
endif;
$activePage = $nav->findActive($nav->getContainer());
//end workaround
switch ($this->siteSetting('subnav_display')) {
    case 'show';
        $displaySubnav = $this->displayNavigation;
        break;
    case 'hide':
        $displaySubnav = false;
        break;
    default:
        $displaySubnav = $this->displayNavigation && $activePage && $activePage['page']->hasPages();
}
$showPagePagination = $this->siteSetting('show_page_pagination', true);
?>

</div><!-- /.container -->

    <?php if ($activePage): ?>
    <?php if ($activePage['depth'] !== 0): ?>
    <div class="container breadcrumbs-container">
      <nav class="breadcrumbs"><?php echo $nav->breadcrumbs(); ?></nav>
    </div>
    <?php endif; ?>
    <?php endif; ?>
    
    <?php if ($activePage): ?>
    <?php if ($displaySubnav): ?>
    <div class="container sub-menu-container">
      <nav class="sub-menu"><?php echo $nav->menu()->renderSubMenu(); ?></nav>
    </div>
    <?php endif; ?>
    <?php endif; ?>
    
    <?php $this->trigger('view.show.before'); ?>
    <div class="blocks">
        <?php echo $this->content; ?>
    </div>

    <?php $this->trigger('view.show.after'); ?>
    <?php if ($showPagePagination): ?>
    <div class="container page-pagination-container">
      <?php echo $this->sitePagePagination(); ?>
    </div>
    <?php endif; ?>

  <div class="container"><!-- reopen .container -->