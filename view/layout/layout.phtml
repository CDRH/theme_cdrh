<?php
$escape = $this->plugin('escapeHtml');
$translate = $this->plugin('translate');
$siteTitle = $site->title();
$headerTitle = $this->themeSetting('header_title');
$headerSubtitle = $this->themeSetting('header_subtitle');
$browseBodyTruncation = ($this->themeSetting('browse_body_truncation')) ? $this->themeSetting('browse_body_truncation') : 'fade';
$banner = $this->themeSettingAssetUrl('banner');
$bannerBackground = $this->themeSetting('bg_banner');
$bsContainerClasses = "container";
$ulClasses = 'navbar-nav';
$breakpoint = '-' . $this->themeSetting('breakpoint');
$browseLayout = $this->themeSetting('browse_layout');

if ($this->themeSetting('show_navbar_2')):
  $navDepth = 1;
else:
  $navDepth = 0;
endif; 

$this->htmlElement('html')->setAttribute('lang', $this->lang());
$this->headMeta()->setCharset('utf-8');
$this->headMeta()->appendName('viewport', 'width=device-width, initial-scale=1');
$this->headTitle($siteTitle)->setSeparator(' | ');
$this->headTitle()->append($this->setting('installation_title', 'Omeka S'));

// CSS
$this->headLink()->prependStylesheet($this->assetUrl('css/style.css'));
$this->headLink()->prependStylesheet($this->assetUrl('css/iconfonts.css', 'Omeka'));
$this->headLink()->prependStylesheet($this->assetUrl('vendor/bootstrap/css/bootstrap.min.css'));

// JS
$this->headScript()->prependFile($this->assetUrl('js/global.js', 'Omeka'));
$this->headScript()->prependFile($this->assetUrl('vendor/jquery/jquery.min.js', 'Omeka'));
$this->headScript()->appendFile($this->assetUrl('vendor/bootstrap/js/bootstrap.bundle.min.js')); 
// To move this scripts to the bottom of the file, use Zend Framework's inlineScript function

$this->jsTranslate();
$this->htmlElement('body')->appendAttribute('class', 'body-truncate-' . $browseBodyTruncation);

// Custom body classes
if ($this->themeSetting('browse_layout')) {
  $this->htmlElement('body')->appendAttribute('class', 'browse-layout-' . $browseLayout);
};


$this->trigger('view.layout'); 
$userBar = $this->userBar();
?>

<?php echo $this->doctype(); ?>
<?php echo $this->htmlElement('html'); ?>
  <head>
    <?php echo $this->headMeta(); ?>
    <?php echo $this->headTitle(); ?>
    <?php echo $this->headLink(); ?>
    <?php echo $this->headStyle(); ?>
    <?php echo $this->headScript(); ?>
    <?php echo $this->partial('common/css-variables.phtml'); ?>
  </head>

  <?php echo $this->htmlElement('body'); ?>
    <div id="body-wrapper">
      <?php if ($banner): ?>
        <header id="header" class="banner" style="background-image: url(<?php echo $banner; ?>);">
        <?php else: ?>
        <header id="header">
      <?php endif; ?>

        <a id="skipnav"class="sr-only sr-only-focusable" href="#main_content"><?php echo $this->translate('Skip to main content'); ?></a>
        
        <?php echo $userBar; ?>

        <div class="site-title-container<?php if ($this->themeSetting('center_header')): ?> text-center<?php endif; ?><?php if ($this->themeSetting('top_right')) echo ' order-0'; ?>">
          <div class="<?php echo $bsContainerClasses; ?>">
            <a href="<?php echo $site->url(); ?>">
              <span class="site-title"><?php echo $escape($headerTitle); ?></span>
              <span class="site-subtitle"><?php echo $escape($headerSubtitle); ?></span>
            </a>
          </div>
        </div>

        <?php if ($this->themeSetting('top_right')): ?>
          <nav class="<?php echo $bsContainerClasses; ?> top-right"
            aria-label="<?php echo ($this->themeSetting('top_right_label')) ? $this->themeSetting('top_right_label') : 'Quick Links'; ?>">
            <?= $this->navMenu('top-right', [
              $activeUrl => 'true',
            ]) ?>
          </nav>
        <?php endif; ?>

        <div class="navbar navbar-expand<?php if ($breakpoint != "-none") echo $breakpoint; ?>">
          <button class="navbar-toggler ms-auto me-2 my-1" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMainMenu" aria-controls="navbarMainMenu" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
          </button>
          <div class="collapse navbar-collapse" id="navbarMainMenu">
            <nav class="navbar navbar-primary d<?php if ($breakpoint != "-none") echo $breakpoint; ?>-flex<?php if ($centerMenu): ?> justify-content<?php if ($breakpoint != "-none") echo $breakpoint; ?>-center<?php endif; ?>"
            aria-label="Main Menu">
              <?php echo $site->publicNav()->menu()->setMinDepth(0)->setMaxDepth($navDepth)->setUlClass($ulClasses); ?>
            </nav>
          </div>
        </div>
      </header>

      <main id="main_content">
        <div class="<?php echo $bsContainerClasses; ?>">
          <?php echo $this->content; ?>
        </div>
      </main>

      <footer id="footer"<?php if ($this->themeSetting('center_footer')): ?> class="text-center"<?php endif; ?>>
        <div class="<?php echo $bsContainerClasses; ?>">
          <?php echo $this->partial('common/footer.phtml'); ?>
        </div>

        <div class="back-to-top">
          <a href="#main_content">Back to top</a>
        </div>
      </footer>
    </div>
  </body>
</html>